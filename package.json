{
  "name": "init-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo-run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start:api": "pnpm --filter @web/api start",
    "dev:api": "pnpm --filter @web/api start --watch",
    "generate": "turbo run generate",
    "push": "turbo run push",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run generate",
    "postinstall": "pnpm -r run stub --if-present",
    "db:push": "turbo run push",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "@scripts/turbo-run": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/tailwind-config": "workspace:*",
    "@internal/vite-config": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "tailwindcss": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "exports": {
    ".": {
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ]
  }
}