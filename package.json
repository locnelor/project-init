{
  "name": "init-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start:worm-system": "pnpm --filter @web/api start worm-system",
    "start:worm-auth": "pnpm --filter @web/api start worm-auth",
    "start:worm-file": "pnpm --filter @web/api start worm-file",
    "start:worm-gateway": "pnpm --filter @web/api start worm-gateway",
    "start:worm-job": "pnpm --filter @web/api start worm-job",
    "dev:worm-system": "pnpm --filter @web/api start worm-system --watch",
    "dev:worm-auth": "pnpm --filter @web/api start worm-auth --watch",
    "dev:worm-file": "pnpm --filter @web/api start worm-file --watch",
    "dev:worm-gateway": "pnpm --filter @web/api start worm-gateway --watch",
    "dev:worm-job": "pnpm --filter @web/api start worm-job --watch",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run generate",
    "db:push": "turbo run push"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}