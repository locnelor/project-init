// 数据库客户端生成配置
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// 数据库连接配置
datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

//********************* system
//账号类型
enum sys_account_provider {
  we_chat // 微信登录
  github // Github登录
  qq // QQ登录
  email // 邮箱登录
  phone // 手机号登录
}

//媒体访问权限类型
enum sys_media_access_type {
  PUBLIC // 公开访问
  PRIVATE // 私有访问
  ROLE // 角色访问
  USER // 用户访问
  DEPARTMENT // 部门访问
}

// 部门表 - 用于组织架构管理
model sys_department {
  uid       String           @id @default(uuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  name      String           @unique /// 部门名称
  code      String           @unique /// 部门编码
  sort      Int              @default(10) /// 排序
  status    Boolean          @default(true) /// 状态
  comment   String?          @db.Text /// 备注
  parent_id String? /// 父部门ID
  parent    sys_department?  @relation("DepartmentParent", fields: [parent_id], references: [uid], onDelete: NoAction, onUpdate: NoAction)
  children  sys_department[] @relation("DepartmentParent")
  users     sys_user[]

  @@index([parent_id])
}

// 系统用户表 - 核心用户信息
model sys_user {
  uid           String              @id @default(uuid())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  name          String /// 用户名称
  account       String              @unique /// 账号
  email         String?             @unique /// 邮箱
  phone         String?             @unique /// 手机号
  avatar        String? /// 头像
  status        Boolean             @default(true) /// 状态
  last_login_at DateTime? /// 最后登录时间
  department_id String? /// 部门ID
  password      String /// 密码
  department    sys_department?     @relation(fields: [department_id], references: [uid])
  accounts      sys_account[] // 关联的登录账号
  roles         sys_user_roles[] // 用户角色关联
  ban_menus     sys_user_ban_menu[] // 用户菜单黑名单
  user_media    sys_user_media[] // 用户关联的媒体文件
  created_media sys_media[]         @relation("MediaCreator") // 用户创建的媒体文件

  @@index([department_id])
}

// 系统账号表 - 用于多渠道登录认证
/**
 * 通过provider与value快速查询。
 * 但password需要单独设置。
 * 例如：${user_id}_account_${password}
 * we_chat_${openid}
 */
model sys_account {
  uid       String               @id @default(uuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt
  provider  sys_account_provider // 登录提供商类型
  value     String // 登录凭证值
  user_id   String
  user      sys_user             @relation(fields: [user_id], references: [uid])

  @@unique([provider, value])
  @@index([user_id])
}

// 用户角色关联表
model sys_user_roles {
  uid       String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user_id   String
  role_id   String
  user      sys_user @relation(fields: [user_id], references: [uid])
  role      sys_role @relation(fields: [role_id], references: [uid])

  @@unique([user_id, role_id])
  @@index([role_id])
}

// 系统菜单表 - 用于前端菜单和权限管理
model sys_menu {
  uid        String              @id @default(uuid())
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt
  name       String /// 菜单名称
  path       String? /// 菜单路径
  component  String? /// 组件路径
  redirect   String? /// 重定向路径
  sort       Int                 @default(10) /// 排序
  icon       String? /// 图标
  visible    Boolean             @default(true) /// 是否显示
  status     Boolean             @default(true) /// 状态
  cache      Boolean             @default(false) /// 是否缓存
  type       String              @default("menu") /// 类型：menu、button、iframe、link
  permission Int                 @default(0) /// 权限标识
  link       String? /// 外链地址
  frame      Boolean             @default(false) /// 是否内嵌iframe
  comment    String?             @db.Text /// 备注
  parent_id  String? /// 父菜单ID
  parent     sys_menu?           @relation("SysMenuParent", fields: [parent_id], references: [uid], onDelete: NoAction, onUpdate: NoAction)
  children   sys_menu[]          @relation("SysMenuParent")
  roles      sys_menu_on_role[] // 菜单角色关联
  user_bans  sys_user_ban_menu[] // 用户菜单黑名单

  @@index([parent_id])
}

// 用户菜单黑名单表 - 用于特定用户禁用某些菜单
model sys_user_ban_menu {
  uid       String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      sys_user @relation(fields: [user_id], references: [uid])
  menu      sys_menu @relation(fields: [menu_id], references: [uid])
  user_id   String
  menu_id   String

  @@unique([user_id, menu_id])
  @@index([menu_id])
}

// 角色菜单权限关联表
model sys_menu_on_role {
  uid       String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  role_id   String
  menu_id   String
  menu      sys_menu @relation(fields: [menu_id], references: [uid])
  role      sys_role @relation(fields: [role_id], references: [uid])

  @@unique([role_id, menu_id])
  @@index([menu_id])
}

// 系统角色表 - 用于角色权限管理
model sys_role {
  uid        String             @id @default(uuid())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @default(now()) @updatedAt
  name       String             @unique /// 角色名称
  code       String             @unique /// 角色编码
  sort       Int                @default(10) /// 排序
  status     Boolean            @default(true) /// 状态
  data_scope String             @default("ALL") /// 数据权限范围：ALL-全部数据，DEPT-本部门数据，DEPT_AND_CHILD-本部门及子部门数据，SELF-仅本人数据，CUSTOM-自定义数据
  comment    String?            @db.LongText /// 备注
  menus      sys_menu_on_role[] // 角色菜单关联
  users      sys_user_roles[] // 角色用户关联
}

// 媒体文件表 - 用于文件存储管理
model sys_media {
  uid            String                @id @default(uuid())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  name           String /// 文件名
  alias          String? /// 文件别名
  keywords       String? /// 关键字，用于搜索
  size           Int /// 文件大小(字节)
  hash           String                @unique /// 文件hash值
  mimeType       String /// 文件MIME类型
  extension      String /// 文件扩展名
  path           String /// 文件存储路径
  url            String? /// 文件访问URL
  thumbnail_url  String? /// 缩略图URL
  access_type    sys_media_access_type @default(PRIVATE) /// 访问权限类型
  enabled        Boolean               @default(true) /// 是否可用
  type           String                @default("file") /// 文件类型:file,image,video,audio,document等
  category       String? /// 文件分类
  tags           String? /// 标签，JSON格式
  width          Int? /// 图片/视频宽度
  height         Int? /// 图片/视频高度
  duration       Int? /// 音视频时长(秒)
  download_count Int                   @default(0) /// 下载次数
  view_count     Int                   @default(0) /// 查看次数
  creator_id     String? /// 创建者ID
  creator        sys_user?             @relation("MediaCreator", fields: [creator_id], references: [uid])
  isWechat       Boolean               @default(false) /// 是否为微信素材
  wechat_id      String?               @unique /// 微信素材ID
  users          sys_user_media[] // 用户媒体关联

  @@index([creator_id])
  @@index([access_type])
  @@index([type])
  @@index([category])
}

// 用户媒体关联表
model sys_user_media {
  uid       String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  user      sys_user  @relation(fields: [user_id], references: [uid])
  media     sys_media @relation(fields: [media_id], references: [uid])
  user_id   String
  media_id  String

  @@unique([user_id, media_id])
  @@index([media_id])
}
