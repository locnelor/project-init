{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/worm-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/worm-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/worm-gateway",
  "projects": {
    "auth-power": {
      "type": "library",
      "root": "libs/auth-power",
      "entryFile": "index",
      "sourceRoot": "libs/auth-power/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth-power/tsconfig.lib.json"
      }
    },
    "error": {
      "type": "library",
      "root": "libs/error",
      "entryFile": "index",
      "sourceRoot": "libs/error/src",
      "compilerOptions": {
        "tsConfigPath": "libs/error/tsconfig.lib.json"
      }
    },
    "file": {
      "type": "library",
      "root": "libs/file",
      "entryFile": "index",
      "sourceRoot": "libs/file/src",
      "compilerOptions": {
        "tsConfigPath": "libs/file/tsconfig.lib.json"
      }
    },
    "hash": {
      "type": "library",
      "root": "libs/hash",
      "entryFile": "index",
      "sourceRoot": "libs/hash/src",
      "compilerOptions": {
        "tsConfigPath": "libs/hash/tsconfig.lib.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "redis-cache": {
      "type": "library",
      "root": "libs/redis-cache",
      "entryFile": "index",
      "sourceRoot": "libs/redis-cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis-cache/tsconfig.lib.json"
      }
    },
    "utils": {
      "type": "library",
      "root": "libs/utils",
      "entryFile": "index",
      "sourceRoot": "libs/utils/src",
      "compilerOptions": {
        "tsConfigPath": "libs/utils/tsconfig.lib.json"
      }
    },
    "wechat": {
      "type": "library",
      "root": "libs/wechat",
      "entryFile": "index",
      "sourceRoot": "libs/wechat/src",
      "compilerOptions": {
        "tsConfigPath": "libs/wechat/tsconfig.lib.json"
      }
    },
    "worm-auth": {
      "type": "application",
      "root": "apps/worm-auth",
      "entryFile": "main",
      "sourceRoot": "apps/worm-auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worm-auth/tsconfig.app.json"
      }
    },
    "worm-file": {
      "type": "application",
      "root": "apps/worm-file",
      "entryFile": "main",
      "sourceRoot": "apps/worm-file/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worm-file/tsconfig.app.json"
      }
    },
    "worm-gateway": {
      "type": "application",
      "root": "apps/worm-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/worm-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worm-gateway/tsconfig.app.json"
      }
    },
    "worm-job": {
      "type": "application",
      "root": "apps/worm-job",
      "entryFile": "main",
      "sourceRoot": "apps/worm-job/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worm-job/tsconfig.app.json"
      }
    },
    "worm-system": {
      "type": "application",
      "root": "apps/worm-system",
      "entryFile": "main",
      "sourceRoot": "apps/worm-system/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worm-system/tsconfig.app.json"
      }
    }
  }
}