# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 微服务端口配置
PORT_GATEWAY=3000
PORT_SYSTEM=3001
PORT_AUTH=3002
PORT_FILE=3003
PORT_JOB=3004

# 文件存储配置
FILE_UPLOAD_PATH=./uploads
FILE_MAX_SIZE=10485760
FILE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip,rar

# 微信配置
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_TOKEN=your-wechat-token
WECHAT_ENCODING_AES_KEY=your-wechat-encoding-aes-key

# QQ登录配置
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key

# GitHub登录配置
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Gitee登录配置
GITEE_CLIENT_ID=your-gitee-client-id
GITEE_CLIENT_SECRET=your-gitee-client-secret

# 邮件配置
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-email-password
MAIL_FROM=your-email@gmail.com

# 短信配置
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=your-sms-sign-name
SMS_TEMPLATE_CODE=your-sms-template-code

# 定时任务配置
JOB_REDIS_HOST=localhost
JOB_REDIS_PORT=6379
JOB_REDIS_PASSWORD=
JOB_REDIS_DB=1

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# 跨域配置
CORS_ORIGIN=http://localhost:5173

# API文档配置
SWAGGER_TITLE=Project API Documentation
SWAGGER_DESCRIPTION=API documentation for the project
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api-docs

# 加密配置
ENCRYPTION_KEY=your-encryption-key
HASH_SALT_ROUNDS=10

# 第三方服务配置
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET=your-oss-bucket
OSS_REGION=your-oss-region
OSS_ENDPOINT=your-oss-endpoint

# 监控配置
MONITOR_ENABLED=false
MONITOR_ENDPOINT=http://localhost:9090

# 开发环境配置
NODE_ENV=development
DEBUG=true